  {"message":
   "Ttc/Exec/CanonPolytope.lean:925:0: @Ttc.ttc_volume_endToEnd_canon : ∀ {A : Type u_1} {n : ℕ} (atoms : A → Ttc.LinAtom n) (φ : Ttc.BForm A) (ε δ : ℝ)\n  (hε0 : 0 < ε) (hε1 : ε ≤ 1),\n  0 < δ →\n    δ ≤ 1 →\n      ∀ (hn : 1 ≤ n) (M : A → Set (Ttc.Space n)),\n        (M = fun a ↦ (atoms a).halfspace) →\n          ∀ (toDNF : Ttc.BForm A → Ttc.DNF A),\n            Ttc.IsDNFOf (toDNF φ) φ →\n              (toDNF φ).IsPositive →\n                ∀ (hm : 1 ≤ Nat.card { c // c ∈ toDNF φ }) (hr : 1 ≤ Nat.card (Ttc.FacetIndex (toDNF φ)))\n                  (P : Ttc.Params),\n                  P = Ttc.ttcParams (toDNF φ) n ε δ hε0 hε1 hn hm hr →\n                    ↑(List.length (toDNF φ)) ≤ ↑P.m →\n                      Bornology.IsBounded (Ttc.sol M φ) →\n                        (∀ (j : Ttc.FacetIndex (toDNF φ)), (atoms (↑j.snd).atom).coeff ≠ 0) →\n                          ∀ (cen : { c // c ∈ toDNF φ } → Ttc.Space n) (gammaHat : ℝ),\n                            0 < gammaHat →\n                              (∀ (i : { c // c ∈ toDNF φ }), Metric.ball (cen i) gammaHat ⊆ Ttc.region M ↑i) →\n                                (∀ c ∈ Ttc.mcGood M (toDNF φ) cen gammaHat P.epsPrime P.deltaPrime,\n                                    (1 - P.epsPrime) * P.thresh / 8 ≤\n                                      ∑ s,\n                                        Ttc.rates M φ (toDNF φ) (P.precision gammaHat)\n                                          (Ttc.e2eSampD M (toDNF φ) (P.precision gammaHat) P.epsPrime\n                                            (Ttc.canonRfac (toDNF φ)) (Ttc.canonAm atoms (toDNF φ))\n                                            (Ttc.canonBv atoms (toDNF φ) (Ttc.latticeScale (P.precision gammaHat))) cen\n                                            gammaHat (Ttc.canonDm M (toDNF φ) (P.precision gammaHat)))\n                                          (Ttc.mcVol M (toDNF φ) cen gammaHat P.epsPrime P.deltaPrime c) s) →\n                                  1 - δ - δ / 4 ≤\n                                      (∫⁻ (c : ℕ → EuclideanSpace ℝ (Fin n)),\n                                          (Ttc.trajLaw\n                                              (Ttc.rates M φ (toDNF φ) (P.precision gammaHat)\n                                                (Ttc.e2eSampD M (toDNF φ) (P.precision gammaHat) P.epsPrime\n                                                  (Ttc.canonRfac (toDNF φ)) (Ttc.canonAm atoms (toDNF φ))\n                                                  (Ttc.canonBv atoms (toDNF φ)\n                                                    (Ttc.latticeScale (P.precision gammaHat)))\n                                                  cen gammaHat (Ttc.canonDm M (toDNF φ) (P.precision gammaHat)))\n                                                (Ttc.mcVol M (toDNF φ) cen gammaHat P.epsPrime P.deltaPrime c)))\n                                            {t |\n                                              Ttc.ttcOutput P\n                                                  (Ttc.coveredOracles M φ (P.precision gammaHat)\n                                                    (Ttc.mcVol M (toDNF φ) cen gammaHat P.epsPrime P.deltaPrime c))\n                                                  toDNF (P.precision gammaHat) φ t ∈\n                                                Ttc.relErr ε (Ttc.volSol M φ)} ∂Ttc.MonteCarlo.coins n).toReal ∧\n                                    ∀ (c : ℕ → Ttc.Space n)\n                                      (t : ℕ → Fin (Ttc.latticeCount M φ (P.precision gammaHat)) → ℕ)\n                                      (cVol cSample thr : ℕ),\n                                      ↑thr = P.thresh →\n                                        Ttc.Terminates P\n                                            (Ttc.coveredOracles M φ (P.precision gammaHat)\n                                              (Ttc.mcVol M (toDNF φ) cen gammaHat P.epsPrime P.deltaPrime c) t)\n                                            (toDNF φ) →\n                                          Ttc.runCost P\n                                              (Ttc.coveredOracles M φ (P.precision gammaHat)\n                                                (Ttc.mcVol M (toDNF φ) cen gammaHat P.epsPrime P.deltaPrime c) t)\n                                              cVol cSample (P.precision gammaHat) (toDNF φ) ≤\n                                            List.length (toDNF φ) * (cVol + cSample * thr)",
   "level": "info"}],
