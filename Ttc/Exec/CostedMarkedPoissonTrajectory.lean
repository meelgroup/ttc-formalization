import Ttc.Exec.CategoricalPoissonIdentification
import Ttc.Exec.CostedInitialThinningTrajectory

/-!
# Exact costed marked-Poisson input for the TTC thinning trajectory

This file is the distributional and cost-preserving adapter from any genuine finite-endpoint
sampler to `Ttc.trajLaw`.  It contains no mixing, geometry, or oracle-price assumption.
-/

namespace Ttc.CostedMarkedPoissonTrajectory

open MeasureTheory ProbabilityTheory
open Ttc.CostedMarkedPoisson
open Ttc.CostedMarkedPoissonIdentified
open Ttc.CostedInitialThinningTrajectory
open scoped ENNReal BigOperators Classical NNReal

variable {L n : Nat}

/-- Cost-preserving pushforward of a genuine fine-grid sampler to a finite categorical mark. -/
noncomputable def finiteSamplerOfFine
    {target : Measure (Ttc.Space n)}
    (S : Ttc.KV97RoundedEndpointBridge.ExpectedQueryFineSampler target)
    (encode : Ttc.Space n → Fin L) (q : Fin L → Real)
    (hencodeMeas : Measurable encode)
    (hencode : Measure.map encode target = categoricalLaw q) :
    ExpectedQueryFiniteSampler q where
  law := Measure.map (fun z : ENNReal × Ttc.Space n => (z.1, encode z.2)) S.law
  probability := by
    letI : IsProbabilityMeasure S.law := S.probability
    exact Measure.isProbabilityMeasure_map
      (measurable_fst.prodMk (hencodeMeas.comp measurable_snd)).aemeasurable
  stateMarginal := by
    letI : IsProbabilityMeasure S.law := S.probability
    let F := fun z : ENNReal × Ttc.Space n => (z.1, encode z.2)
    have hF : Measurable F :=
      measurable_fst.prodMk (hencodeMeas.comp measurable_snd)
    calc
      Measure.map Prod.snd (Measure.map F S.law) =
          Measure.map (Prod.snd ∘ F) S.law := Measure.map_map measurable_snd hF
      _ = Measure.map (encode ∘ Prod.snd) S.law := rfl
      _ = Measure.map encode (Measure.map Prod.snd S.law) :=
        (Measure.map_map hencodeMeas measurable_snd).symm
      _ = categoricalLaw q := by rw [S.stateMarginal, hencode]
  expectedQueries := S.expectedQueries
  expectedQueries_eq := by
    letI : IsProbabilityMeasure S.law := S.probability
    let F := fun z : ENNReal × Ttc.Space n => (z.1, encode z.2)
    have hF : Measurable F :=
      measurable_fst.prodMk (hencodeMeas.comp measurable_snd)
    calc
      (∫⁻ z, z.1 ∂Measure.map F S.law) =
          ∫⁻ z, (F z).1 ∂S.law := by
            simpa only [Function.comp_apply] using
              (MeasureTheory.lintegral_map measurable_fst hF)
      _ = S.expectedQueries := S.expectedQueries_eq

/-- The honest uncapped marked-Poisson level-zero law generated by a finite sampler. -/
noncomputable def levelZeroLaw {q : Fin L → Real}
    (S : ExpectedQueryFiniteSampler q) (lam : Real) :
    Measure (ENNReal × (Fin L → Nat)) :=
  actualCostedMarkedLaw (poissonMeasure lam.toNNReal) S.law

instance {q : Fin L → Real} (S : ExpectedQueryFiniteSampler q) (lam : Real) :
    IsProbabilityMeasure (levelZeroLaw S lam) := by
  letI : IsProbabilityMeasure S.law := S.probability
  unfold levelZeroLaw
  infer_instance

/-- Exact categorical marking identifies the level-zero state with `countLaw`. -/
theorem map_snd_levelZeroLaw_eq_countLaw {lam : Real} (hlam : 0 ≤ lam)
    {q : Fin L → Real} (hq0 : ∀ a, 0 ≤ q a) (hq : ∑ a, q a = 1)
    (S : ExpectedQueryFiniteSampler q) :
    Measure.map Prod.snd (levelZeroLaw S lam) = Ttc.countLaw lam q := by
  letI : IsProbabilityMeasure S.law := S.probability
  apply map_snd_actualCostedMarkedLaw_eq_countLaw
  apply markedPoissonIdentified_of_stateMarginal S.law S.stateMarginal
  exact categoricalPoissonIdentified hlam hq0 hq

/-- Exact expected recorded membership queries at level zero. -/
theorem lintegral_fst_levelZeroLaw {q : Fin L → Real}
    (S : ExpectedQueryFiniteSampler q) (lam : Real) :
    (∫⁻ z, z.1 ∂levelZeroLaw S lam) =
      (lam.toNNReal : ENNReal) * S.expectedQueries := by
  letI : IsProbabilityMeasure S.law := S.probability
  rw [levelZeroLaw,
    lintegral_fst_actualCostedMarkedLaw_poisson lam.toNNReal S.law,
    S.expectedQueries_eq]

/-- The complete operational sample trajectory: Poisson marking once, then free thinning. -/
noncomputable def trajectoryLaw {q : Fin L → Real}
    (S : ExpectedQueryFiniteSampler q) (lam : Real) :
    Measure (Nat → ENNReal × (Fin L → Nat)) :=
  costedTrajLaw (levelZeroLaw S lam)

instance {q : Fin L → Real} (S : ExpectedQueryFiniteSampler q) (lam : Real) :
    IsProbabilityMeasure (trajectoryLaw S lam) := by
  unfold trajectoryLaw
  infer_instance

/-- Forgetting all recorded costs gives exactly the TTC coupled Poisson trajectory. -/
theorem map_forgetCost_trajectoryLaw_eq_trajLaw {lam : Real} (hlam : 0 ≤ lam)
    {q : Fin L → Real} (hq0 : ∀ a, 0 ≤ q a) (hq : ∑ a, q a = 1)
    (S : ExpectedQueryFiniteSampler q) :
    Measure.map (Ttc.SequentialCostedPathLumping.pathMap Prod.snd)
        (trajectoryLaw S lam) = Ttc.trajLaw (fun a => lam * q a) := by
  letI : IsProbabilityMeasure S.law := S.probability
  apply map_forgetCost_costedTrajLaw_eq_trajLaw_of_countLaw hlam hq0 hq
  exact map_snd_levelZeroLaw_eq_countLaw hlam hq0 hq S

/-- Any nonempty finite TTC prefix has exactly the Poisson marking mean query cost. -/
theorem lintegral_finitePrefixQueryCost_trajectoryLaw {q : Fin L → Real}
    (S : ExpectedQueryFiniteSampler q) (lam : Real) {J : Nat} (hJ : 0 < J) :
    (∫⁻ omega, finitePrefixQueryCost J omega ∂trajectoryLaw S lam) =
      (lam.toNNReal : ENNReal) * S.expectedQueries := by
  letI : IsProbabilityMeasure S.law := S.probability
  rw [trajectoryLaw, lintegral_finitePrefixQueryCost_eq_initialMean _ hJ,
    lintegral_fst_levelZeroLaw]

#print axioms finiteSamplerOfFine
#print axioms map_snd_levelZeroLaw_eq_countLaw
#print axioms lintegral_fst_levelZeroLaw
#print axioms map_forgetCost_trajectoryLaw_eq_trajLaw
#print axioms lintegral_finitePrefixQueryCost_trajectoryLaw

end Ttc.CostedMarkedPoissonTrajectory
