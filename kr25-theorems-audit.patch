+    (i : Fin D.componentCount) (state : TTCState n) (outcome : VolumeOutcome)
+    (hsamples : (state.samples.card : Real) ≤ p.threshold D.componentCount) :
+    let P := D.component i
+    let deleted := state.removeComponent P
