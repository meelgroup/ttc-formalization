+private theorem certified_component_list_mass_le_one {n k : Nat}
+    (hn : 21 ≤ n) {F : LRAFormula n k} (D : Decomposition F)
+    (p : ApproxParams) (b : Nat)
+    (hprecision : PrecisionAdequate D b p.latticeEta p.epsilonPrime)
