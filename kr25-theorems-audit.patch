+import ttc.Model.Program
+import ttc.Analysis.MeasurableFixedSfiniteBind
+import Mathlib.Probability.Kernel.MeasurableLIntegral
+
+/-!
+# Forgetting a real-RAM operation trace
+
+The costed program is a writer-style composition of measure-valued steps.
+These lemmas prove that operation counts do not change its output law.
+-/
+
+namespace ttc
+
+open MeasureTheory
+
+instance TTCState.instMeasurableSingletonClass (n : Nat) :
+    MeasurableSingletonClass (TTCState n) where
+  measurableSet_singleton s := by
+    let f : TTCState n → NNReal × Finset (SampleCopy n) × Nat :=
+      fun t => (t.rate, t.samples, t.nextLabel)
+    have hinj : Function.Injective f := by
+      intro x y h
+      cases x
+      cases y
+      simp only [f, Prod.mk.injEq] at h
+      congr
+      all_goals tauto
+    have hset : ({s} : Set (TTCState n)) = f ⁻¹' {f s} := by
+      ext x
+      simp only [Set.mem_singleton_iff, Set.mem_preimage]
+      exact (hinj.eq_iff).symm
+    rw [hset]
+    exact ⟨{f s}, measurableSet_singleton _, rfl⟩
+
+theorem costedCharge_fst {α : Type*} [MeasurableSpace α]
+    (law : Measure α) (operations : Nat) :
+    (costedCharge law operations).map Prod.fst = law := by
+  unfold costedCharge
+  rw [Measure.map_map measurable_fst (by fun_prop)]
+  change law.map id = law
+  exact Measure.map_id
+
+set_option maxHeartbeats 800000 in
+theorem costedBind_dirac_eq_map {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    [MeasurableSingletonClass α] [MeasurableSingletonClass β]
+    (law : Measure (α × Nat)) (f : α → β) (g : α → Nat)
+    (hf : Measurable f) (hg : Measurable g) :
+    costedBind law (fun x => costedCharge (Measure.dirac (f x)) (g x)) =
+      law.map (fun result => (f result.1, result.2 + g result.1)) := by
+  unfold costedBind costedCharge
+  simp only [Measure.map_dirac]
+  have hmap : Measurable (fun result : α × Nat =>
+      (f result.1, result.2 + g result.1)) :=
+    (hf.comp measurable_fst).prodMk
+      (measurable_snd.add (hg.comp measurable_fst))
+  exact Measure.bind_dirac_eq_map law hmap
+
+theorem costedCharge_expected_cost {α : Type*} [MeasurableSpace α]
+    (law : Measure α) [IsProbabilityMeasure law] (operations : Nat) :
+    ∫⁻ result, (result.2 : ENNReal) ∂costedCharge law operations = operations := by
+  unfold costedCharge
+  rw [lintegral_map (by fun_prop) (by fun_prop)]
+  simp only [lintegral_const, measure_univ, mul_one]
+
+theorem costedCharge_mass_le_one {α : Type*} [MeasurableSpace α]
+    (law : Measure α) (operations : Nat) (hlaw : law Set.univ ≤ 1) :
+    (costedCharge law operations) Set.univ ≤ 1 := by
+  unfold costedCharge
+  rw [Measure.map_apply (by fun_prop) MeasurableSet.univ]
+  simpa using hlaw
+
+theorem map_bind_measure {α β γ : Type*}
+    [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
+    (law : Measure α) (step : α → Measure β) (f : β → γ)
+    (hstep : AEMeasurable step law) (hf : Measurable f) :
+    (law.bind step).map f = law.bind fun x => (step x).map f := by
+  ext s hs
+  have hmapstep : AEMeasurable (fun x => (step x).map f) law :=
+    (Measure.measurable_map f hf).comp_aemeasurable hstep
+  calc
+    ((law.bind step).map f) s = (law.bind step) (f ⁻¹' s) :=
+      Measure.map_apply hf hs
+    _ = ∫⁻ x, step x (f ⁻¹' s) ∂law := Measure.bind_apply (hf hs) hstep
+    _ = ∫⁻ x, ((step x).map f) s ∂law :=
+      lintegral_congr fun x => (Measure.map_apply hf hs).symm
+    _ = (law.bind fun x => (step x).map f) s :=
+      (Measure.bind_apply hs hmapstep).symm
+
+private theorem measurable_costedContinuation {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (next : α → Measure (β × Nat)) (hnext : Measurable next) :
+    Measurable (fun result : α × Nat =>
+      (next result.1).map fun future => (future.1, result.2 + future.2)) := by
+  apply measurable_from_prod_countable_left
+  intro cost
+  exact (Measure.measurable_map
+    (fun future : β × Nat => (future.1, cost + future.2)) (by fun_prop)).comp hnext
+
+theorem costedBind_kernel_measurable {X α β : Type*}
+    [MeasurableSpace X] [MeasurableSpace α] [MeasurableSpace β]
+    (first : X → Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hfirst : Measurable first) (hnext : Measurable next) :
+    Measurable (fun x => costedBind (first x) next) := by
+  let continuation : (α × Nat) → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future => (future.1, result.2 + future.2)
+  have hcont : Measurable continuation := measurable_costedContinuation next hnext
+  exact (Measure.measurable_bind' hcont).comp hfirst
+
+theorem costedBind_costedCharge_eq_bind {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (law : Measure α) (operations : Nat)
+    (next : α → Measure (β × Nat)) (hnext : Measurable next) :
+    costedBind (costedCharge law operations) next =
+      law.bind fun x => (next x).map fun future =>
+        (future.1, operations + future.2) := by
+  let f : α → α × Nat := fun x => (x, operations)
+  let K : α × Nat → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future => (future.1, result.2 + future.2)
+  have hf : Measurable f := measurable_id.prodMk measurable_const
+  have hK : Measurable K := measurable_costedContinuation next hnext
+  change (law.map f).bind K = _
+  calc
+    (law.map f).bind K = (law.bind fun x => Measure.dirac (f x)).bind K := by
+      rw [Measure.bind_dirac_eq_map law hf]
+    _ = law.bind fun x => (Measure.dirac (f x)).bind K :=
+      Measure.bind_bind ((Measure.measurable_dirac.comp hf).aemeasurable) hK.aemeasurable
+    _ = law.bind fun x => K (f x) := by simp only [Measure.dirac_bind hK]
+    _ = _ := rfl
+
+theorem costedBind_costedCharge_dirac_eq_map {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (x : α) (operations : Nat) (next : α → Measure (β × Nat))
+    (hnext : Measurable next) :
+    costedBind (costedCharge (Measure.dirac x) operations) next =
+      (next x).map (fun future => (future.1, operations + future.2)) := by
+  rw [costedBind_costedCharge_eq_bind _ _ _ hnext]
+  have hshift : Measurable (fun z =>
+      (next z).map (fun future => (future.1, operations + future.2))) :=
+    (Measure.measurable_map _ (by fun_prop)).comp hnext
+  exact Measure.dirac_bind hshift x
+
+theorem measurable_nat_bind_kernel {X β : Type*}
+    [MeasurableSpace X] [MeasurableSpace β]
+    (law : X → Measure Nat) (next : X × Nat → Measure β)
+    (hlaw : Measurable law) (hnext : Measurable next) :
+    Measurable (fun x => (law x).bind fun pending => next (x, pending)) := by
+  apply Measure.measurable_of_measurable_coe
+  intro event hevent
+  have hsection (x : X) : Measurable (fun pending : Nat => next (x, pending)) :=
+    Measurable.of_discrete
+  simp_rw [Measure.bind_apply hevent (hsection _).aemeasurable,
+    lintegral_countable']
+  apply Measurable.tsum
+  intro pending
+  exact ((Measure.measurable_coe hevent).comp
+      (hnext.comp (measurable_id.prodMk measurable_const))).mul
+    ((Measure.measurable_coe (measurableSet_singleton pending)).comp hlaw)
+
+theorem measurable_nat_costedCharge_bind_kernel {X β : Type*}
+    [MeasurableSpace X] [MeasurableSpace β]
+    (law : X → Measure Nat) (next : X × Nat → Measure (β × Nat))
+    (operations : Nat) (hlaw : Measurable law) (hnext : Measurable next) :
+    Measurable (fun x => costedBind (costedCharge (law x) operations)
+      (fun pending => next (x, pending))) := by
+  let shift : β × Nat → β × Nat := fun future =>
+    (future.1, operations + future.2)
+  have hshift : Measurable shift := by fun_prop
+  have hnextShift : Measurable (fun z : X × Nat => (next z).map shift) :=
+    (Measure.measurable_map shift hshift).comp hnext
+  have htail := measurable_nat_bind_kernel law
+    (fun z : X × Nat => (next z).map shift) hlaw hnextShift
+  have heq :
+      (fun x => costedBind (costedCharge (law x) operations)
+        (fun pending => next (x, pending))) =
+      (fun x => (law x).bind fun pending => (next (x, pending)).map shift) := by
+    funext x
+    exact costedBind_costedCharge_eq_bind (law x) operations
+      (fun pending => next (x, pending)) Measurable.of_discrete
+  rw [heq]
+  exact htail
+
+set_option maxHeartbeats 800000 in
+theorem measurable_costedBind_fixed_source_map_kernel {X Y α β : Type*}
+    [MeasurableSpace X] [MeasurableSpace Y]
+    [MeasurableSpace α] [MeasurableSpace β]
+    (source : Measure Y) [SFinite source]
+    (draw : X × Y → α × Nat)
+    (next : X × α → Measure (β × Nat))
+    (hdraw : Measurable draw) (hnext : Measurable next) :
+    Measurable (fun x => costedBind
+      (source.map fun y => draw (x, y))
+      (fun a => next (x, a))) := by
+  let C : X × (α × Nat) → Measure (β × Nat) := fun z =>
+    (next (z.1, z.2.1)).map fun future =>
+      (future.1, z.2.2 + future.2)
+  have hC : Measurable C := by
+    let C' : (X × α) × Nat → Measure (β × Nat) := fun z =>
+      (next z.1).map fun future => (future.1, z.2 + future.2)
+    have hC' : Measurable C' := by
+      apply measurable_from_prod_countable_left
+      intro cost
+      exact (Measure.measurable_map
+        (fun future : β × Nat => (future.1, cost + future.2)) (by fun_prop)).comp hnext
+    exact hC'.comp
+      ((measurable_fst.prodMk (measurable_fst.comp measurable_snd)).prodMk
+        (measurable_snd.comp measurable_snd))
+  let K : X × Y → Measure (β × Nat) := fun z => C (z.1, draw z)
+  have hK : Measurable K := hC.comp (measurable_fst.prodMk hdraw)
+  have hfixed := measurable_fixed_sfinite_bind source K hK
+  have heq :
+      (fun x => costedBind (source.map fun y => draw (x, y))
+        (fun a => next (x, a))) =
+      (fun x => source.bind fun y => K (x, y)) := by
+    funext x
+    let f : Y → α × Nat := fun y => draw (x, y)
+    have hf : Measurable f := hdraw.comp (measurable_const.prodMk measurable_id)
+    let G : α × Nat → Measure (β × Nat) := fun a => C (x, a)
+    have hG : Measurable G := hC.comp (measurable_const.prodMk measurable_id)
+    change (source.map f).bind G = source.bind fun y => G (f y)
+    calc
+      (source.map f).bind G =
+          (source.bind fun y => Measure.dirac (f y)).bind G := by
+        rw [Measure.bind_dirac_eq_map source hf]
+      _ = source.bind fun y => (Measure.dirac (f y)).bind G :=
+        Measure.bind_bind ((Measure.measurable_dirac.comp hf).aemeasurable)
+          hG.aemeasurable
+      _ = source.bind fun y => G (f y) := by simp only [Measure.dirac_bind hG]
+  rw [heq]
+  exact hfixed
+
+theorem measurable_map_dependent_finite {X Y Z : Type*}
+    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]
+    (law : X → Measure Y) (f : X × Y → Z)
+    (hlaw : Measurable law) (hf : Measurable f)
+    (hmass : ∀ x, law x Set.univ ≤ 1) :
+    Measurable (fun x => (law x).map fun y => f (x, y)) := by
+  let κ : ProbabilityTheory.Kernel X Y := ⟨law, hlaw⟩
+  have hfinite : ∀ x, IsFiniteMeasure (κ x) := fun x =>
+    ⟨lt_of_le_of_lt (hmass x) ENNReal.one_lt_top⟩
+  apply Measure.measurable_of_measurable_coe
+  intro s hs
+  have hset : MeasurableSet (f ⁻¹' s) := hf hs
+  have hbase := ProbabilityTheory.Kernel.measurable_kernel_prodMk_left_of_finite
+    (κ := κ) hset hfinite
+  have heq :
+      (fun x => ((law x).map fun y => f (x, y)) s) =
+      (fun x => κ x (Prod.mk x ⁻¹' (f ⁻¹' s))) := by
+    funext x
+    have hfx : Measurable (fun y => f (x, y)) :=
+      hf.comp measurable_prodMk_left
+    rw [Measure.map_apply hfx hs]
+    rfl
+  rw [heq]
+  exact hbase
+
+theorem measurable_costedBind_dependent_finite {X α β : Type*}
+    [MeasurableSpace X] [MeasurableSpace α] [MeasurableSpace β]
+    (first : X → Measure (α × Nat))
+    (next : X × α → Measure (β × Nat))
+    (hfirst : Measurable first) (hnext : Measurable next)
+    (hmass : ∀ x, first x Set.univ ≤ 1) :
+    Measurable (fun x => costedBind (first x) (fun a => next (x, a))) := by
+  let C : X × (α × Nat) → Measure (β × Nat) := fun z =>
+    (next (z.1, z.2.1)).map fun future =>
+      (future.1, z.2.2 + future.2)
+  have hC : Measurable C := by
+    let C' : (X × α) × Nat → Measure (β × Nat) := fun z =>
+      (next z.1).map fun future => (future.1, z.2 + future.2)
+    have hC' : Measurable C' := by
+      apply measurable_from_prod_countable_left
+      intro cost
+      exact (Measure.measurable_map
+        (fun future : β × Nat => (future.1, cost + future.2)) (by fun_prop)).comp hnext
+    exact hC'.comp
+      ((measurable_fst.prodMk (measurable_fst.comp measurable_snd)).prodMk
+        (measurable_snd.comp measurable_snd))
+  let lift : X × (α × Nat) → X × (α × Nat) := id
+  have hlift : Measurable (fun x =>
+      (first x).map fun a => (x, a)) :=
+    measurable_map_dependent_finite first lift hfirst measurable_id hmass
+  have hbind : Measurable (fun x =>
+      ((first x).map fun a => (x, a)).bind C) :=
+    (Measure.measurable_bind' hC).comp hlift
+  have heq :
+      (fun x => costedBind (first x) (fun a => next (x, a))) =
+      (fun x => ((first x).map fun a => (x, a)).bind C) := by
+    funext x
+    let f : α × Nat → X × (α × Nat) := fun a => (x, a)
+    have hf : Measurable f := measurable_const.prodMk measurable_id
+    change (first x).bind (fun a => C (x, a)) = ((first x).map f).bind C
+    calc
+      (first x).bind (fun a => C (x, a)) =
+          (first x).bind (fun a => (Measure.dirac (f a)).bind C) := by
+        simp only [Measure.dirac_bind hC]
+        rfl
+      _ = ((first x).bind fun a => Measure.dirac (f a)).bind C :=
+        (Measure.bind_bind ((Measure.measurable_dirac.comp hf).aemeasurable)
+          hC.aemeasurable).symm
+      _ = ((first x).map f).bind C := by
+        rw [Measure.bind_dirac_eq_map (first x) hf]
+  rw [heq]
+  exact hbind
+
+theorem costedBind_fst {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hnext : Measurable next) :
+    (costedBind first next).map Prod.fst =
+      (first.map Prod.fst).bind fun x => (next x).map Prod.fst := by
+  let continuation : (α × Nat) → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future => (future.1, result.2 + future.2)
+  have hcont : Measurable continuation := measurable_costedContinuation next hnext
+  unfold costedBind
+  rw [map_bind_measure first continuation Prod.fst hcont.aemeasurable measurable_fst]
+  have hpoint : ∀ result : α × Nat,
+      (continuation result).map Prod.fst = (next result.1).map Prod.fst := by
+    intro result
+    unfold continuation
+    rw [Measure.map_map measurable_fst (by fun_prop)]
+    rfl
+  simp only [hpoint]
+  change first.bind (fun result => (next result.1).map Prod.fst) =
+    (first.map Prod.fst).bind (fun x => (next x).map Prod.fst)
+  unfold Measure.bind
+  rw [Measure.map_map (by fun_prop) measurable_fst]
+  rfl
+
+/-- Expected cost of a charged composition, assuming each continuation is a
+probability law. This is the accounting identity used for TTC components. -/
+theorem costedBind_lintegral_cost {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hnext : Measurable next)
+    (hprob : ∀ x, IsProbabilityMeasure (next x)) :
+    ∫⁻ run, (run.2 : ENNReal) ∂costedBind first next =
+      ∫⁻ result, (result.2 : ENNReal) +
+        ∫⁻ future, (future.2 : ENNReal) ∂next result.1 ∂first := by
+  let continuation : (α × Nat) → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future => (future.1, result.2 + future.2)
+  have hcont : Measurable continuation := measurable_costedContinuation next hnext
+  unfold costedBind
+  rw [Measure.lintegral_bind hcont.aemeasurable (by fun_prop)]
+  congr 1
+  funext result
+  change (∫⁻ run, (run.2 : ENNReal) ∂continuation result) = _
+  rw [lintegral_map (by fun_prop) (by fun_prop)]
+  simp only [Nat.cast_add]
+  rw [lintegral_add_left (by fun_prop)]
+  haveI : IsProbabilityMeasure (next result.1) := hprob result.1
+  simp only [lintegral_const, measure_univ, mul_one]
+
+/-- An upper expected-cost inequality requiring only subprobability
+continuations. It applies to adaptive TTC binds before kernel measurability
+has been established. -/
+theorem costedBind_lintegral_cost_le {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hnext : ∀ x, (next x) Set.univ ≤ 1) :
+    ∫⁻ run, (run.2 : ENNReal) ∂costedBind first next ≤
+      ∫⁻ result, (result.2 : ENNReal) +
+        ∫⁻ future, (future.2 : ENNReal) ∂next result.1 ∂first := by
+  let continuation : (α × Nat) → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future => (future.1, result.2 + future.2)
+  have hmap (result : α × Nat) :
+      (∫⁻ run, (run.2 : ENNReal) ∂continuation result) =
+      (result.2 : ENNReal) * (next result.1) Set.univ +
+        ∫⁻ future, (future.2 : ENNReal) ∂next result.1 := by
+    unfold continuation
+    rw [lintegral_map (by fun_prop) (by fun_prop)]
+    simp only [Nat.cast_add]
+    rw [lintegral_add_left (by fun_prop)]
+    simp only [lintegral_const]
+  unfold costedBind
+  apply (Measure.lintegral_bind_le _ first continuation).trans
+  simp_rw [hmap]
+  apply lintegral_mono
+  intro result
+  exact add_le_add_left
+    (mul_le_of_le_one_right (by positivity) (hnext result.1)) _
+
+theorem costedBind_mass_le_one {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hfirst : first Set.univ ≤ 1) (hnext : ∀ x, (next x) Set.univ ≤ 1) :
+    (costedBind first next) Set.univ ≤ 1 := by
+  let continuation : (α × Nat) → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future => (future.1, result.2 + future.2)
+  have hcont (result : α × Nat) : continuation result Set.univ ≤ 1 := by
+    unfold continuation
+    rw [Measure.map_apply (by fun_prop) MeasurableSet.univ]
+    simpa using hnext result.1
+  unfold costedBind
+  calc
+    (first.bind continuation) Set.univ ≤
+        ∫⁻ result, continuation result Set.univ ∂first :=
+      Measure.bind_apply_le continuation MeasurableSet.univ
+    _ ≤ ∫⁻ _result, (1 : ENNReal) ∂first := lintegral_mono hcont
+    _ = first Set.univ := by simp
+    _ ≤ 1 := hfirst
+
+/-- Uniform one-step cost bounds add across adaptive charged binds, even
+when the adaptive kernel has not yet been shown measurable. -/
+theorem costedBind_expected_cost_le_add {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hfirstMass : first Set.univ ≤ 1)
+    (hnextMass : ∀ x, (next x) Set.univ ≤ 1)
+    {firstBudget nextBudget : ENNReal}
+    (hfirstCost : (∫⁻ result, (result.2 : ENNReal) ∂first) ≤ firstBudget)
+    (hnextCost : ∀ x, (∫⁻ result, (result.2 : ENNReal) ∂next x) ≤ nextBudget) :
+    (∫⁻ result, (result.2 : ENNReal) ∂costedBind first next) ≤
+      firstBudget + nextBudget := by
+  apply (costedBind_lintegral_cost_le first next hnextMass).trans
+  have hpoint :
+      (∫⁻ result, (result.2 : ENNReal) +
+        ∫⁻ future, (future.2 : ENNReal) ∂next result.1 ∂first) ≤
+      ∫⁻ result, (result.2 : ENNReal) + nextBudget ∂first := by
+    apply lintegral_mono
+    intro result
+    simpa using add_le_add_left (hnextCost result.1) (result.2 : ENNReal)
+  apply hpoint.trans
+  rw [lintegral_add_left (by fun_prop)]
+  simp only [lintegral_const]
+  exact add_le_add hfirstCost
+    (mul_le_of_le_one_right (by positivity) hfirstMass)
+
+/-- The same accounting rule when a continuation bound holds almost surely
+for the state produced by the first computation. This permits TTC's thinning
+guard and stored-population invariant to be used inside adaptive binds. -/
+theorem costedBind_expected_cost_le_add_ae {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (hfirstMass : first Set.univ ≤ 1)
+    (hnextMass : ∀ x, (next x) Set.univ ≤ 1)
+    {firstBudget nextBudget : ENNReal}
+    (hfirstCost : (∫⁻ result, (result.2 : ENNReal) ∂first) ≤ firstBudget)
+    (hnextCost : ∀ᵐ result ∂first,
+      (∫⁻ future, (future.2 : ENNReal) ∂next result.1) ≤ nextBudget) :
+    (∫⁻ result, (result.2 : ENNReal) ∂costedBind first next) ≤
+      firstBudget + nextBudget := by
+  apply (costedBind_lintegral_cost_le first next hnextMass).trans
+  have hpoint :
+      (∫⁻ result, (result.2 : ENNReal) +
+        ∫⁻ future, (future.2 : ENNReal) ∂next result.1 ∂first) ≤
+      ∫⁻ result, (result.2 : ENNReal) + nextBudget ∂first := by
+    apply lintegral_mono_ae
+    filter_upwards [hnextCost] with result hresult
+    simpa using add_le_add_left hresult (result.2 : ENNReal)
+  apply hpoint.trans
+  rw [lintegral_add_left (by fun_prop)]
+  simp only [lintegral_const]
+  exact add_le_add hfirstCost
+    (mul_le_of_le_one_right (by positivity) hfirstMass)
+
+/-- A deterministic state update contributes its fixed charge before an
+adaptive charged continuation. -/
+theorem costedBind_charge_dirac_expected_cost_le {α β : Type*}
+    [MeasurableSpace α] [MeasurableSingletonClass α] [MeasurableSpace β]
+    (x : α) (charge : Nat) (next : α → Measure (β × Nat))
+    (hnextMass : ∀ y, (next y) Set.univ ≤ 1) :
+    (∫⁻ result, (result.2 : ENNReal) ∂
+      costedBind (costedCharge (Measure.dirac x) charge) next) ≤
+      charge + ∫⁻ result, (result.2 : ENNReal) ∂next x := by
+  apply (costedBind_lintegral_cost_le _ next hnextMass).trans
+  unfold costedCharge
+  apply (lintegral_map_le _ _).trans
+  simp only [lintegral_dirac]
+  exact le_rfl
+
+/-- A fixed charge followed by a mapped oracle result can be bounded using
+only a pointwise continuation budget and the oracle's total mass. -/
+theorem costedCharge_map_continuation_bound {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (law : Measure α) (clip : α → β) (charge : Nat)
+    (continuationCost : β → ENNReal) (hlaw : law Set.univ ≤ 1)
+    {budget : ENNReal} (hbudget : ∀ x, continuationCost (clip x) ≤ budget) :
+    (∫⁻ result, (result.2 : ENNReal) + continuationCost result.1 ∂
+      costedCharge (law.map clip) charge) ≤ charge + budget := by
+  unfold costedCharge
+  apply (lintegral_map_le _ _).trans
+  apply (lintegral_map_le _ _).trans
+  apply (lintegral_mono (fun x => add_le_add_right (hbudget x) _)).trans
+  simp only [lintegral_const]
+  exact mul_le_of_le_one_right (by positivity) hlaw
+
+/-- An almost-sure state invariant propagates through a charged bind. The
+writer addition changes only the cost coordinate. -/
+theorem costedBind_ae_state_of_ae {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (Good : α → Prop) (Goal : β → Prop)
+    (hGoal : MeasurableSet {y | Goal y})
+    (hfirst : ∀ᵐ result ∂first, Good result.1)
+    (hnext : ∀ x, Good x → ∀ᵐ future ∂next x, Goal future.1) :
+    ∀ᵐ result ∂costedBind first next, Goal result.1 := by
+  let bad : Set (β × Nat) := {result | ¬ Goal result.1}
+  have hbad : MeasurableSet bad :=
+    (hGoal.preimage measurable_fst).compl
+  rw [ae_iff]
+  change (costedBind first next) bad = 0
+  let continuation : (α × Nat) → Measure (β × Nat) := fun result =>
+    (next result.1).map fun future =>
+      (future.1, result.2 + future.2)
+  have hpoint : ∀ᵐ result ∂first, continuation result bad = 0 := by
+    filter_upwards [hfirst] with result hgood
+    have hfuture := hnext result.1 hgood
+    rw [ae_iff] at hfuture
+    unfold continuation
+    rw [Measure.map_apply (by fun_prop) hbad]
+    simpa only [bad, Set.preimage_setOf_eq] using hfuture
+  unfold costedBind
+  apply le_antisymm
+  · calc
+    (first.bind continuation) bad ≤ ∫⁻ result, continuation result bad ∂first :=
+      Measure.bind_apply_le continuation hbad
+    _ = 0 := by
+      rw [lintegral_congr_ae hpoint]
+      simp
+  · exact bot_le
+
+theorem costedCharge_dirac_ae_state {α : Type*}
+    [MeasurableSpace α] (x : α) (charge : Nat)
+    (Goal : α → Prop) (hGoal : MeasurableSet {y | Goal y})
+    (hx : Goal x) :
+    ∀ᵐ result ∂costedCharge (Measure.dirac x) charge, Goal result.1 := by
+  have hset : MeasurableSet {result : α × Nat | Goal result.1} :=
+    hGoal.preimage measurable_fst
+  have hmap : Measurable (fun y : α => (y, charge)) := by fun_prop
+  unfold costedCharge
+  rw [ae_map_iff hmap.aemeasurable hset]
+  exact (ae_dirac_iff hGoal).2 hx
+
+theorem costedBind_ae_state_of_forall {α β : Type*}
+    [MeasurableSpace α] [MeasurableSpace β]
+    (first : Measure (α × Nat)) (next : α → Measure (β × Nat))
+    (Goal : β → Prop) (hGoal : MeasurableSet {y | Goal y})
+    (hnext : ∀ x, ∀ᵐ future ∂next x, Goal future.1) :
+    ∀ᵐ result ∂costedBind first next, Goal result.1 := by
+  apply costedBind_ae_state_of_ae first next (fun _ => True) Goal hGoal
+  · exact Filter.Eventually.of_forall (fun _ => trivial)
+  · intro x _
+    exact hnext x
+
+end ttc
diff --git a/lean/ttc/Analysis/FairThinningExpectation.lean b/lean/ttc/Analysis/FairThinningExpectation.lean
new file mode 100644
index 0000000..c20e1c6
--- /dev/null
+++ b/lean/ttc/Analysis/FairThinningExpectation.lean
@@ -0,0 +1,470 @@
+import ttc.Analysis.FairCoinStreamLawIsProbabilityMeasure
+import ttc.Analysis.MeasurableSetSurvives
+import ttc.Analysis.MeasurableSurvivorCount
+import ttc.Analysis.MeasurableFirstExitRound
+import ttc.Analysis.NatTailExpectation
+import ttc.Analysis.ManuscriptThinningCosts
+import Mathlib.Analysis.SpecificLimits.Basic
+
+/-!
+# Survival probabilities in the manuscript thinning loop
+
+Each labelled copy survives a fixed number of fair rounds with probability
+`2⁻ʳ`. This is the input to the second-loop expectation bound.
+-/
+
+namespace ttc
+
+open MeasureTheory ProbabilityTheory Set
+open Classical
+
+theorem fairCoinLaw_true : fairCoinLaw {true} = (1 / 2 : ENNReal) := by
+  have hprob : (fairProbability : Real) = 1 / 2 := by
+    unfold fairProbability
+    rw [Set.projIcc_of_mem zero_le_one
+      (show (1 / 2 : Real) ∈ Set.Icc 0 1 by norm_num)]
+  unfold fairCoinLaw
+  rw [bernoulliMeasure_apply_of_mem_of_notMem fairProbability
+    (by measurability) (by simp) (by simp)]
+  have hnn : unitInterval.toNNReal fairProbability = (1 / 2 : NNReal) := by
+    apply Subtype.ext
+    simpa using hprob
+  rw [hnn]
+  norm_num
+
+theorem fairCoinStreamLaw_survives (rounds label : Nat) :
+    fairCoinStreamLaw {coins | survives coins rounds label} =
+      (1 / 2 : ENNReal) ^ rounds := by
+  have hprobAll : ∀ _ : Nat × Nat, IsProbabilityMeasure fairCoinLaw :=
+    fun _ => fairCoinLaw_isProbabilityMeasure
+  let s : Finset (Nat × Nat) := (Finset.range rounds).image fun r => (r, label)
+  have hs : {coins : Nat × Nat → Bool | survives coins rounds label} =
+      Set.pi (s : Set (Nat × Nat)) (fun _ => {true}) := by
+    ext coins
+    simp [survives, s, Set.mem_pi]
+  rw [hs, fairCoinStreamLaw]
+  rw [Measure.infinitePi_pi (hμ := hprobAll) (μ := fun _ : Nat × Nat => fairCoinLaw)
+    (s := s) (by intros; measurability)]
+  simp only [fairCoinLaw_true, Finset.prod_const]
+  have hcard : s.card = rounds := by
+    unfold s
+    rw [Finset.card_image_of_injective]
+    · simp
+    · intro x y h
+      exact congrArg Prod.fst h
+  simp [hcard]
+
+/-- Linearity of expectation for finitely many labelled copies; labels need
+not be distinct. -/
+theorem expected_survivor_card {α : Type*} [DecidableEq α]
+    (copies : Finset α) (label : α → Nat) (rounds : Nat) :
+    ∫⁻ coins, (((copies.filter fun a => survives coins rounds (label a)).card : Nat) : ENNReal)
+        ∂fairCoinStreamLaw =
+      copies.card * (1 / 2 : ENNReal) ^ rounds := by
+  classical
+  induction copies using Finset.induction_on with
+  | empty => simp
+  | @insert a copies ha ih =>
+      have hset : MeasurableSet
+          {coins : Nat × Nat → Bool | survives coins rounds (label a)} :=
+        measurableSet_survives rounds (label a)
+      have hindicator :
+          (∫⁻ coins, (if survives coins rounds (label a) then (1 : ENNReal) else 0)
+              ∂fairCoinStreamLaw) = (1 / 2 : ENNReal) ^ rounds := by
+        have hfun : (fun coins : Nat × Nat → Bool =>
+            if survives coins rounds (label a) then (1 : ENNReal) else 0) =
+            Set.indicator {coins | survives coins rounds (label a)} 1 := by
+          funext coins
+          by_cases h : survives coins rounds (label a) <;> simp [h, Set.indicator]
+        rw [hfun, lintegral_indicator_one hset, fairCoinStreamLaw_survives]
+      have hrewrite :
+          (∫⁻ coins, (((((insert a copies).filter
+            fun x => survives coins rounds (label x)).card : Nat) : ENNReal))
+              ∂fairCoinStreamLaw) =
+          (∫⁻ coins, ((if survives coins rounds (label a) then (1 : ENNReal) else 0) +
+            ((((copies.filter fun x => survives coins rounds (label x)).card : Nat) :
+              ENNReal))) ∂fairCoinStreamLaw) := by
+        apply lintegral_congr
+        intro coins
+        rw [Finset.filter_insert]
+        by_cases h : survives coins rounds (label a) <;>
+          simp [h, ha, Finset.card_insert_of_notMem, add_comm]
+      rw [hrewrite]
+      rw [lintegral_add_left (Measurable.ite hset measurable_const measurable_const),
+        hindicator, ih]
+      simp only [Finset.card_insert_of_notMem ha, Nat.cast_add, Nat.cast_one]
+      ring
+
+/-- Expected retained copies after a fixed number of thinning rounds. -/
+theorem expected_samplesAfter_card {n : Nat}
+    (samples : Finset (SampleCopy n)) (rounds : Nat) :
+    ∫⁻ coins, ((samplesAfter coins rounds samples).card : ENNReal)
+        ∂fairCoinStreamLaw =
+      samples.card * (1 / 2 : ENNReal) ^ rounds := by
+  classical
+  simpa [samplesAfter] using expected_survivor_card samples Prod.fst rounds
+
+/-- Expected pending copies after a fixed number of thinning rounds. -/
+theorem expected_pendingAfter (firstLabel count rounds : Nat) :
+    ∫⁻ coins, (pendingAfter coins rounds firstLabel count : ENNReal)
+        ∂fairCoinStreamLaw =
+      count * (1 / 2 : ENNReal) ^ rounds := by
+  classical
+  simpa [pendingAfter] using
+    expected_survivor_card (Finset.range count) (fun i => firstLabel + i) rounds
+
+/-- Expected combined retained and pending population at a fixed round. -/
+theorem expected_thinning_population {n : Nat} (s : TTCState n)
+    (pending rounds : Nat) :
+    ∫⁻ coins, (((samplesAfter coins rounds s.samples).card +
+        pendingAfter coins rounds s.nextLabel pending : Nat) : ENNReal)
+        ∂fairCoinStreamLaw =
+      (s.samples.card + pending : ENNReal) * (1 / 2 : ENNReal) ^ rounds := by
+  have hmeas : Measurable (fun coins : Nat × Nat → Bool =>
+      ((samplesAfter coins rounds s.samples).card : ENNReal)) := by
+    exact (measurable_of_countable (fun q : Nat => (q : ENNReal))).comp
+      (by simpa [samplesAfter] using
+        measurable_survivorCount s.samples (fun copy => copy.1) rounds)
+  simp only [Nat.cast_add]
+  rw [lintegral_add_left hmeas, expected_samplesAfter_card,
+    expected_pendingAfter]
+  rw [← add_mul]
+
+/-- A fixed-round tail bound for the population that controls the second
+thinning guard. -/
+theorem thinning_population_tail {n : Nat} (s : TTCState n)
+    (pending rounds cutoff : Nat) (hcutoff : 0 < cutoff) :
+    fairCoinStreamLaw {coins | cutoff ≤
+      (samplesAfter coins rounds s.samples).card +
+        pendingAfter coins rounds s.nextLabel pending} ≤
+      ((s.samples.card + pending : ENNReal) * (1 / 2 : ENNReal) ^ rounds) /
+        cutoff := by
+  let f : (Nat × Nat → Bool) → ENNReal := fun coins =>
+    (((samplesAfter coins rounds s.samples).card +
+      pendingAfter coins rounds s.nextLabel pending : Nat) : ENNReal)
+  have hsample : Measurable (fun coins : Nat × Nat → Bool =>
+      (samplesAfter coins rounds s.samples).card) := by
+    simpa [samplesAfter] using
+      measurable_survivorCount s.samples (fun copy => copy.1) rounds
+  have hpending : Measurable (fun coins : Nat × Nat → Bool =>
+      pendingAfter coins rounds s.nextLabel pending) := by
+    simpa [pendingAfter] using
+      measurable_survivorCount (Finset.range pending)
+        (fun i => s.nextLabel + i) rounds
+  have hf : Measurable f := by
+    exact (measurable_of_countable (fun q : Nat => (q : ENNReal))).comp
+      (hsample.add hpending)
+  have hmarkov := meas_ge_le_lintegral_div (μ := fairCoinStreamLaw)
+    hf.aemeasurable (show (cutoff : ENNReal) ≠ 0 by exact_mod_cast hcutoff.ne')
+    (by simp : (cutoff : ENNReal) ≠ ⊤)
+  change fairCoinStreamLaw {coins | (cutoff : ENNReal) ≤ f coins} ≤
+    (∫⁻ coins, f coins ∂fairCoinStreamLaw) / cutoff at hmarkov
+  rw [show (∫⁻ coins, f coins ∂fairCoinStreamLaw) =
+      (s.samples.card + pending : ENNReal) * (1 / 2 : ENNReal) ^ rounds from
+    expected_thinning_population s pending rounds] at hmarkov
+  have hset : {coins | cutoff ≤
+      (samplesAfter coins rounds s.samples).card +
+        pendingAfter coins rounds s.nextLabel pending} =
+      {coins | (cutoff : ENNReal) ≤ f coins} := by
+    ext coins
+    simp only [Set.mem_ofPred_eq, f]
+    norm_cast
+  rw [hset]
+  exact hmarkov
+
+/-- A tail bound for the actual first-exit round. Any integer cutoff strictly
+above the real guard threshold may be used. -/
+theorem firstExitRound_tail {n : Nat} (s : TTCState n)
+    (pending rounds cutoff : Nat) (threshold : Real)
+    (hcutoff : 0 < cutoff)
+    (hthreshold : ∀ q : Nat, q < cutoff → (q : Real) ≤ threshold) :
+    fairCoinStreamLaw {coins | rounds < firstExitRound s pending threshold coins} ≤
+      ((s.samples.card + pending : ENNReal) * (1 / 2 : ENNReal) ^ rounds) /
+        cutoff := by
+  have hsubset :
+      {coins | rounds < firstExitRound s pending threshold coins} ⊆
+      {coins | cutoff ≤ (samplesAfter coins rounds s.samples).card +
+        pendingAfter coins rounds s.nextLabel pending} := by
+    intro coins hcoins
+    by_contra hsmall
+    have hsmall' : (samplesAfter coins rounds s.samples).card +
+        pendingAfter coins rounds s.nextLabel pending < cutoff :=
+      Nat.lt_of_not_ge hsmall
+    have hexit : thinningExit s pending threshold coins rounds := by
+      unfold thinningExit
+      simpa only [Nat.cast_add] using hthreshold _ hsmall'
+    have hround : firstExitRound s pending threshold coins ≤ rounds := by
+      unfold firstExitRound
+      exact Nat.sInf_le hexit
+    exact (not_le_of_gt hcoins) hround
+  exact (measure_mono hsubset).trans
+    (thinning_population_tail s pending rounds cutoff hcutoff)
+
+/-- The cutoff in the exit-round tail can be selected directly from the
+real manuscript threshold. -/
+theorem firstExitRound_tail_floor {n : Nat} (s : TTCState n)
+    (pending rounds : Nat) (threshold : Real) (hthreshold : 0 ≤ threshold) :
+    fairCoinStreamLaw {coins | rounds < firstExitRound s pending threshold coins} ≤
+      ((s.samples.card + pending : ENNReal) * (1 / 2 : ENNReal) ^ rounds) /
+        (Nat.floor threshold + 1) := by
+  have htail := firstExitRound_tail s pending rounds (Nat.floor threshold + 1)
+    threshold (Nat.succ_pos _) (by
+      intro q hq
+      have hle : q ≤ Nat.floor threshold := Nat.lt_succ_iff.mp hq
+      exact (Nat.cast_le.mpr hle).trans (Nat.floor_le hthreshold))
+  simpa only [Nat.cast_add, Nat.cast_one] using htail
+
+/-- The second-loop exit counter has finite expectation, with a bound linear
+in its entry population divided by the integer guard cutoff. -/
+theorem expected_firstExitRound_le {n : Nat} (s : TTCState n)
+    (pending cutoff : Nat) (threshold : Real) (hcutoff : 0 < cutoff)
+    (hthreshold : ∀ q : Nat, q < cutoff → (q : Real) ≤ threshold) :
+    ∫⁻ coins, (firstExitRound s pending threshold coins : ENNReal)
+        ∂fairCoinStreamLaw ≤
+      2 * ((s.samples.card + pending : ENNReal) / cutoff) := by
+  rw [lintegral_nat_eq_tsum_tail fairCoinStreamLaw
+    (firstExitRound s pending threshold)
+    (measurable_firstExitRound s pending threshold)]
+  calc
+    (∑' rounds : Nat, fairCoinStreamLaw
+        {coins | rounds < firstExitRound s pending threshold coins}) ≤
+        ∑' rounds : Nat,
+          ((s.samples.card + pending : ENNReal) *
+            (1 / 2 : ENNReal) ^ rounds) / cutoff := by
+      exact ENNReal.tsum_le_tsum (fun rounds =>
+        firstExitRound_tail s pending rounds cutoff threshold hcutoff hthreshold)
+    _ = ((s.samples.card + pending : ENNReal) / cutoff) *
+        (∑' rounds : Nat, (1 / 2 : ENNReal) ^ rounds) := by
+      have hterm (rounds : Nat) :
+          ((s.samples.card + pending : ENNReal) *
+            (1 / 2 : ENNReal) ^ rounds) / cutoff =
+          ((s.samples.card + pending : ENNReal) / cutoff) *
+            (1 / 2 : ENNReal) ^ rounds := by
+        simp only [div_eq_mul_inv]
+        ac_rfl
+      simp_rw [hterm]
+      exact ENNReal.tsum_mul_left
+    _ = 2 * ((s.samples.card + pending : ENNReal) / cutoff) := by
+      rw [ENNReal.tsum_geometric]
+      norm_num
+      ac_rfl
+
+theorem expected_firstExitRound_le_floor {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) (hthreshold : 0 ≤ threshold) :
+    ∫⁻ coins, (firstExitRound s pending threshold coins : ENNReal)
+        ∂fairCoinStreamLaw ≤
+      2 * ((s.samples.card + pending : ENNReal) / (Nat.floor threshold + 1)) := by
+  have hbound := expected_firstExitRound_le s pending
+    (Nat.floor threshold + 1) threshold (Nat.succ_pos _) (by
+      intro q hq
+      exact (Nat.cast_le.mpr (Nat.lt_succ_iff.mp hq)).trans
+        (Nat.floor_le hthreshold))
+  simpa only [Nat.cast_add, Nat.cast_one] using hbound
+
+/-- Exact mean charge of the count-thinning law. -/
+theorem manuscriptCountThinWithCost_expected_eq {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) :
+    ∫⁻ result, (result.2 : ENNReal) ∂
+        manuscriptCountThinWithCost s pending threshold =
+      (TTCRuntime.countThinningRoundOperations s.samples.card : ENNReal) *
+        (∫⁻ coins, (firstExitRound s pending threshold coins : ENNReal)
+          ∂fairCoinStreamLaw) := by
+  have hcost : Measurable (fun coins : Nat × Nat → Bool =>
+      manuscriptCountThinningCost s pending threshold coins) := by
+    unfold manuscriptCountThinningCost
+    exact (measurable_of_countable
+      (fun rounds : Nat => rounds *
+        TTCRuntime.countThinningRoundOperations s.samples.card)).comp
+      (measurable_firstExitRound s pending threshold)
+  have hpair : Measurable (fun coins : Nat × Nat → Bool =>
+      (thinningResult s pending threshold coins,
+        manuscriptCountThinningCost s pending threshold coins)) :=
+    (measurable_thinningResult s pending threshold).prodMk hcost
+  unfold manuscriptCountThinWithCost
+  rw [lintegral_map (by fun_prop) hpair]
+  simp only [manuscriptCountThinningCost, Nat.cast_mul]
+  have hmeas : Measurable (fun coins : Nat × Nat → Bool =>
+      (firstExitRound s pending threshold coins : ENNReal)) :=
+    (measurable_of_countable (fun q : Nat => (q : ENNReal))).comp
+      (measurable_firstExitRound s pending threshold)
+  rw [lintegral_mul_const
+    (TTCRuntime.countThinningRoundOperations s.samples.card : ENNReal) hmeas]
+  rw [mul_comm (∫⁻ coins, (firstExitRound s pending threshold coins : ENNReal)
+    ∂fairCoinStreamLaw)]
+
+/-- The charged count-thinning law inherits the finite first-exit mean. -/
+theorem manuscriptCountThinWithCost_expected_le {n : Nat} (s : TTCState n)
+    (pending cutoff : Nat) (threshold : Real) (hcutoff : 0 < cutoff)
+    (hthreshold : ∀ q : Nat, q < cutoff → (q : Real) ≤ threshold) :
+    ∫⁻ result, (result.2 : ENNReal) ∂
+        manuscriptCountThinWithCost s pending threshold ≤
+      (TTCRuntime.countThinningRoundOperations s.samples.card : ENNReal) *
+        (2 * ((s.samples.card + pending : ENNReal) / cutoff)) := by
+  rw [manuscriptCountThinWithCost_expected_eq]
+  exact mul_le_mul_of_nonneg_left
+    (expected_firstExitRound_le s pending cutoff threshold hcutoff hthreshold)
+    (by positivity)
+
+/-- Every finite thinning population exits the manuscript guard almost
+surely. This removes the `sInf ∅ = 0` totalization branch from analysis. -/
+theorem never_thinningExit_null {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) (hthreshold : 0 ≤ threshold) :
+    fairCoinStreamLaw {coins | ∀ rounds,
+      ¬ thinningExit s pending threshold coins rounds} = 0 := by
+  let never : Set (Nat × Nat → Bool) :=
+    {coins | ∀ rounds, ¬ thinningExit s pending threshold coins rounds}
+  have hbound (rounds : Nat) : fairCoinStreamLaw never ≤
+      ((s.samples.card + pending : NNReal) : ENNReal) *
+        (1 / 2 : ENNReal) ^ rounds := by
+    have hsubset : never ⊆ {coins | 1 ≤
+        (samplesAfter coins rounds s.samples).card +
+          pendingAfter coins rounds s.nextLabel pending} := by
+      intro coins hcoins
+      have hnot := hcoins rounds
+      have hpos : 0 < (samplesAfter coins rounds s.samples).card +
+          pendingAfter coins rounds s.nextLabel pending := by
+        by_contra h
+        have hz : (samplesAfter coins rounds s.samples).card +
+            pendingAfter coins rounds s.nextLabel pending = 0 := Nat.eq_zero_of_not_pos h
+        apply hnot
+        unfold thinningExit
+        simpa only [← Nat.cast_add, hz, Nat.cast_zero] using hthreshold
+      exact hpos
+    have ht := (measure_mono hsubset).trans
+      (thinning_population_tail s pending rounds 1 (by omega))
+    simpa using ht
+  change fairCoinStreamLaw never = 0
+  exact ENNReal.eq_zero_of_le_mul_pow (by norm_num : (1 / 2 : ENNReal) < 1)
+    hbound
+
+/-- The totalized first-exit counter satisfies its guard almost surely. -/
+theorem firstExitRound_guard_ae {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) (hthreshold : 0 ≤ threshold) :
+    ∀ᵐ coins ∂fairCoinStreamLaw,
+      thinningExit s pending threshold coins
+        (firstExitRound s pending threshold coins) := by
+  rw [ae_iff]
+  apply measure_mono_null ?_ (never_thinningExit_null s pending threshold hthreshold)
+  intro coins hbad
+  intro rounds hexit
+  have hs : ({r : Nat | thinningExit s pending threshold coins r}).Nonempty :=
+    ⟨rounds, hexit⟩
+  have hleast : thinningExit s pending threshold coins
+      (firstExitRound s pending threshold coins) := by
+    unfold firstExitRound
+    exact Nat.sInf_mem hs
+  exact hbad hleast
+
+/-- Appending a batch cannot create more stored copies than its length. -/
+theorem TTCState.addBatch_card_le {n count : Nat} (s : TTCState n)
+    (points : Fin count → LatticePoint n) :
+    (s.addBatch points).samples.card ≤ s.samples.card + count := by
+  classical
+  unfold TTCState.addBatch
+  dsimp
+  apply (Finset.card_union_le _ _).trans
+  have hadded : (Finset.univ.image
+      (fun i : Fin count => (s.nextLabel + i.val, points i))).card ≤ count := by
+    simpa using (Finset.card_image_le (s := (Finset.univ : Finset (Fin count)))
+      (f := fun i => (s.nextLabel + i.val, points i)))
+  exact Nat.add_le_add_left hadded _
+
+/-- The uncharged thinning law exits with no more than the guard's population
+almost surely. -/
+theorem thinUntil_population_le_ae {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) (hthreshold : 0 ≤ threshold) :
+    ∀ᵐ result ∂thinUntil s pending threshold,
+      ((result.1.samples.card + result.2 : Nat) : Real) ≤ threshold := by
+  have hmap : Measurable (thinningResult s pending threshold) :=
+    measurable_thinningResult s pending threshold
+  have hset : MeasurableSet {result : TTCState n × Nat |
+      ((result.1.samples.card + result.2 : Nat) : Real) ≤ threshold} := by
+    have hcoords : Measurable (fun state : TTCState n =>
+        (state.rate, state.samples, state.nextLabel)) := comap_measurable _
+    have hsamples : Measurable (fun result : TTCState n × Nat =>
+        result.1.samples) :=
+      ((measurable_fst.comp measurable_snd).comp hcoords).comp measurable_fst
+    have hcard : Measurable (fun result : TTCState n × Nat =>
+        result.1.samples.card) :=
+      (measurable_of_countable (fun copies : Finset (SampleCopy n) => copies.card)).comp
+        hsamples
+    have htotal : Measurable (fun result : TTCState n × Nat =>
+        result.1.samples.card + result.2) := hcard.add measurable_snd
+    exact ((measurable_of_countable (fun q : Nat => (q : Real))).comp htotal)
+      measurableSet_Iic
+  unfold thinUntil
+  rw [ae_map_iff hmap.aemeasurable hset]
+  filter_upwards [firstExitRound_guard_ae s pending threshold hthreshold] with coins hcoins
+  simpa only [thinningResult, Nat.cast_add, thinningExit] using hcoins
+
+/-- Forgetting the charged round count transports the same exit guard to the
+result law used by the runtime program. -/
+theorem manuscriptCountThinWithCost_population_le_ae {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) (hthreshold : 0 ≤ threshold) :
+    ∀ᵐ result ∂manuscriptCountThinWithCost s pending threshold,
+      ((result.1.1.samples.card + result.1.2 : Nat) : Real) ≤ threshold := by
+  have hset : MeasurableSet {result : TTCState n × Nat |
+      ((result.1.samples.card + result.2 : Nat) : Real) ≤ threshold} := by
+    have hcoords : Measurable (fun state : TTCState n =>
+        (state.rate, state.samples, state.nextLabel)) := comap_measurable _
+    have hsamples : Measurable (fun result : TTCState n × Nat =>
+        result.1.samples) :=
+      ((measurable_fst.comp measurable_snd).comp hcoords).comp measurable_fst
+    have hcard : Measurable (fun result : TTCState n × Nat =>
+        result.1.samples.card) :=
+      (measurable_of_countable (fun copies : Finset (SampleCopy n) => copies.card)).comp
+        hsamples
+    have htotal : Measurable (fun result : TTCState n × Nat =>
+        result.1.samples.card + result.2) := hcard.add measurable_snd
+    exact ((measurable_of_countable (fun q : Nat => (q : Real))).comp htotal)
+      measurableSet_Iic
+  have hbase := thinUntil_population_le_ae s pending threshold hthreshold
+  rw [← manuscriptCountThinWithCost_fst s pending threshold] at hbase
+  exact (ae_map_iff measurable_fst.aemeasurable hset).mp hbase
+
+/-- Any batch requested after a successful second-loop guard leaves the
+stored population below the same threshold. -/
+theorem thinningResult_addBatch_card_le {n : Nat} (s : TTCState n)
+    (pending : Nat) (threshold : Real) (coins : Nat × Nat → Bool)
+    (hguard : thinningExit s pending threshold coins
+      (firstExitRound s pending threshold coins))
+    (points : Fin (thinningResult s pending threshold coins).2 → LatticePoint n) :
+    (((thinningResult s pending threshold coins).1.addBatch points).samples.card : Real) ≤
+      threshold := by
+  have hcard := TTCState.addBatch_card_le
+    (thinningResult s pending threshold coins).1 points
+  have hguard' : ((thinningResult s pending threshold coins).1.samples.card +
+      (thinningResult s pending threshold coins).2 : Nat) ≤
+      threshold := by
+    simpa [thinningResult, thinningExit, Nat.cast_add] using hguard
+  exact (Nat.cast_le.mpr hcard).trans hguard'
+
+theorem TTCState.removeComponent_card_le {n : Nat} (s : TTCState n)
+    (P : PolytopeData n) :
+    (s.removeComponent P).samples.card ≤ s.samples.card := by
+  classical
+  unfold TTCState.removeComponent
+  dsimp
+  exact Finset.card_filter_le _ _
+
+theorem deletionPassOperations_le {n : Nat} (s : TTCState n)
+    (P : PolytopeData n) :
+    TTCRuntime.deletionPassOperations n P.presentation.facetCount
+      s.samples.card (s.samples.card - (s.removeComponent P).samples.card) ≤
+      s.samples.card * (TTCRuntime.facetScanOperations n
+        P.presentation.facetCount + 1) := by
+  unfold TTCRuntime.deletionPassOperations TTCRuntime.deleteCopyOperations
+  have hremove : s.samples.card - (s.removeComponent P).samples.card ≤
+      s.samples.card := Nat.sub_le _ _
+  simp only [Nat.mul_add, mul_one]
+  omega
+
+theorem manuscriptRateThinningResult_card_le {n : Nat} (s : TTCState n)
+    (intensity : NNReal) (threshold : Real) (coins : Nat × Nat → Bool) :
+    (manuscriptRateThinningResult s intensity threshold coins).samples.card ≤
+      s.samples.card := by
+  dsimp only [manuscriptRateThinningResult]
+  unfold samplesAfter
+  exact Finset.card_filter_le _ _
+
+end ttc
