+          (p.deltaPrime D.componentCount) (p.threshold D.componentCount)
+          rest)) Set.univ ≤ 1
+      apply costedBind_mass_le_one
+      · exact certified_manuscript_component_mass_le_one hn D p b hprecision
+          prep factor i state
