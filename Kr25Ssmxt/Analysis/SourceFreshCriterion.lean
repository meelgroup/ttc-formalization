import Kr25Ssmxt.Analysis.MathlibCompat
import Kr25Ssmxt.Analysis.SourceRefreshIdempotent

/-! An observed prefix independent of a fair unused source tail is exactly a
law fixed by the source refresh kernel. -/

namespace Kr25Ssmxt

open MeasureTheory

/-- Applying refresh exposes the unused fair tail as a product with the
observed-prefix representative, for any incoming ghost law. -/
theorem origin_refresh_prefix_tail_product
    {n : Nat} (μ : Measure (OriginConfiguration n)) :
    (μ.bind (fun c => c.refreshLaw)).map
      (fun c => (c.observedRepresentative, c.unusedTail)) =
    (μ.map (fun c => c.observedRepresentative)).prod
      (Measure.infinitePi
        (fun _ : Nat × (Nat × Nat) => fairCoinLaw)) := by
  let sourceLaw : Measure (Nat × (Nat × Nat) → Bool) :=
    Measure.infinitePi (fun _ => fairCoinLaw)
  let observed : OriginConfiguration n →
      OriginConfiguration n :=
    fun c => c.observedRepresentative
  let split : OriginConfiguration n →
      OriginConfiguration n × (Nat × (Nat × Nat) → Bool) :=
    fun c => (observed c, c.unusedTail)
  have hobserved : Measurable observed :=
    measurable_originObservedRepresentative
  have hsplit : Measurable split :=
    hobserved.prodMk measurable_originUnusedTail
  have hkernel : Measurable
      (fun c : OriginConfiguration n => c.refreshLaw) :=
    measurable_originConfiguration_refreshLaw
  have hsource : IsProbabilityMeasure sourceLaw := by
    dsimp [sourceLaw]
    letI : ∀ _ : Nat × (Nat × Nat), IsProbabilityMeasure fairCoinLaw :=
      fun _ => fairCoinLaw_isProbabilityMeasure
    infer_instance
  have hleft (c : OriginConfiguration n) :
      c.refreshLaw.map split =
      sourceLaw.map (Prod.mk (observed c)) := by
    change (sourceLaw.map c.refreshFuture).map split = _
    rw [Measure.map_map hsplit c.measurable_refreshFuture]
    congr 1
    funext future
    apply Prod.ext
    · exact c.observedRepresentative_refresh future
    · exact c.unusedTail_refreshFuture future
  let K : OriginConfiguration n →
      Measure (OriginConfiguration n ×
        (Nat × (Nat × Nat) → Bool)) :=
    fun base => sourceLaw.map (Prod.mk base)
  have hK : Measurable K := by
    letI : IsProbabilityMeasure sourceLaw := hsource
    exact Measurable.map_prodMk_left
  calc
    (μ.bind (fun c => c.refreshLaw)).map split =
      μ.bind (fun c => c.refreshLaw.map split) :=
        map_bind_measure μ (fun c => c.refreshLaw) split
          hkernel.aemeasurable hsplit
    _ = μ.bind (fun c => K (observed c)) := by
      apply Measure.bind_congr_right
      apply Filter.Eventually.of_forall
      exact hleft
    _ = (μ.map observed).bind K :=
      (bind_mapped_measure μ observed hobserved K hK).symm
    _ = (μ.map observed).prod sourceLaw := by
      rw [Measure.prod_eq_bind_map]

/-- A refreshed law is generated by first choosing its observed-prefix
representative and then drawing one independent global fair tail. -/
theorem origin_refreshLaw_product_representation
    {n : Nat} (μ : Measure (OriginConfiguration n)) :
    μ.bind (fun c => c.refreshLaw) =
    ((μ.map (fun c => c.observedRepresentative)).prod
      (Measure.infinitePi
        (fun _ : Nat × (Nat × Nat) => fairCoinLaw))).map
      (fun z => z.1.refreshFuture z.2) := by
  let ν := μ.bind (fun c : OriginConfiguration n => c.refreshLaw)
  let split : OriginConfiguration n →
      OriginConfiguration n × (Nat × (Nat × Nat) → Bool) :=
    fun c => (c.observedRepresentative, c.unusedTail)
  let decode : OriginConfiguration n ×
      (Nat × (Nat × Nat) → Bool) → OriginConfiguration n :=
    fun z => z.1.refreshFuture z.2
  have hsplit : Measurable split :=
    measurable_originObservedRepresentative.prodMk
      measurable_originUnusedTail
  have hdecode : Measurable decode :=
    OriginConfiguration.measurable_refreshFuture_joint
  have hpath : decode ∘ split = id := by
    funext c
    exact (c.observedRepresentative_refreshFuture c.unusedTail).trans
      c.refreshFuture_unusedTail
  calc
    ν = (ν.map split).map decode := by
      rw [Measure.map_map hdecode hsplit, hpath, Measure.map_id]
    _ = _ := by
      rw [origin_refresh_prefix_tail_product μ]

theorem origin_prefix_tail_product_of_stationary
    {n : Nat} (μ : Measure (OriginConfiguration n))
    (hstationary :
      μ.bind (fun c : OriginConfiguration n => c.refreshLaw) = μ) :
    μ.map (fun c => (c.observedRepresentative, c.unusedTail)) =
    (μ.map (fun c => c.observedRepresentative)).prod
      (Measure.infinitePi
        (fun _ : Nat × (Nat × Nat) => fairCoinLaw)) := by
  calc
    μ.map (fun c => (c.observedRepresentative, c.unusedTail)) =
      (μ.bind (fun c => c.refreshLaw)).map
        (fun c => (c.observedRepresentative, c.unusedTail)) := by
          rw [hstationary]
    _ = _ := origin_refresh_prefix_tail_product μ

theorem origin_refresh_stationary_of_prefix_tail_product
    {n : Nat} (μ : Measure (OriginConfiguration n))
    (hproduct :
      μ.map (fun c => (c.observedRepresentative, c.unusedTail)) =
      (μ.map (fun c => c.observedRepresentative)).prod
        (Measure.infinitePi
          (fun _ : Nat × (Nat × Nat) => fairCoinLaw))) :
    μ.bind (fun c => c.refreshLaw) = μ := by
  let sourceLaw : Measure (Nat × (Nat × Nat) → Bool) :=
    Measure.infinitePi (fun _ => fairCoinLaw)
  let observed : OriginConfiguration n →
      OriginConfiguration n :=
    fun c => c.observedRepresentative
  let split : OriginConfiguration n →
      OriginConfiguration n × (Nat × (Nat × Nat) → Bool) :=
    fun c => (observed c, c.unusedTail)
  let decode : OriginConfiguration n ×
      (Nat × (Nat × Nat) → Bool) → OriginConfiguration n :=
    fun z => z.1.refreshFuture z.2
  have hobserved : Measurable observed :=
    measurable_originObservedRepresentative
  have hsplit : Measurable split :=
    hobserved.prodMk measurable_originUnusedTail
  have hdecode : Measurable decode :=
    OriginConfiguration.measurable_refreshFuture_joint
  have hkernel : Measurable
      (fun c : OriginConfiguration n => c.refreshLaw) :=
    measurable_originConfiguration_refreshLaw
  have hinner : Measurable (fun base : OriginConfiguration n =>
      sourceLaw.map (Prod.mk base)) := by
    letI : IsProbabilityMeasure sourceLaw := by
      dsimp [sourceLaw]
      letI : ∀ _ : Nat × (Nat × Nat), IsProbabilityMeasure fairCoinLaw :=
        fun _ => fairCoinLaw_isProbabilityMeasure
      infer_instance
    exact Measurable.map_prodMk_left
  have hpath (c : OriginConfiguration n) :
      decode (split c) = c := by
    exact (c.observedRepresentative_refreshFuture c.unusedTail).trans
      c.refreshFuture_unusedTail
  have hreconstruct :
      ((μ.map observed).prod sourceLaw).map decode = μ := by
    rw [← hproduct]
    change (μ.map split).map decode = μ
    rw [Measure.map_map hdecode hsplit]
    have hfun : decode ∘ split = id := funext hpath
    rw [hfun, Measure.map_id]
  have hproddecode :
      ((μ.map observed).prod sourceLaw).map decode =
      (μ.map observed).bind (fun base => base.refreshLaw) := by
    haveI : IsProbabilityMeasure sourceLaw := by
      dsimp [sourceLaw]
      haveI : ∀ _ : Nat × (Nat × Nat), IsProbabilityMeasure fairCoinLaw :=
        fun _ => fairCoinLaw_isProbabilityMeasure
      infer_instance
    rw [Measure.prod_eq_bind_map]
    rw [map_bind_measure (μ.map observed)
      (fun base => sourceLaw.map (Prod.mk base)) decode
      hinner.aemeasurable hdecode]
    congr 1
    funext base
    rw [Measure.map_map hdecode measurable_prodMk_left]
    rfl
  calc
    μ.bind (fun c => c.refreshLaw) =
      μ.bind (fun c => (observed c).refreshLaw) := by
        congr 1
        funext c
        exact (c.observedRepresentative_refreshLaw).symm
    _ = (μ.map observed).bind
        (fun base => base.refreshLaw) :=
      (bind_mapped_measure μ observed hobserved _ hkernel).symm
    _ = ((μ.map observed).prod sourceLaw).map decode := hproddecode.symm
    _ = μ := hreconstruct

end Kr25Ssmxt
