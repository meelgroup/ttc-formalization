import Kr25Ssmxt.Analysis.MathlibCompat
import Kr25Ssmxt.Analysis.ManuscriptRefreshStationaryKernel
import Kr25Ssmxt.Analysis.ManuscriptStationaryFixedLevelKernel
import Kr25Ssmxt.Analysis.ManuscriptOriginVolumeFold
import Kr25Ssmxt.Analysis.ManuscriptFixedLevelCoverage

/-! The ghost component fold with all CV18 outcomes fixed. At every fixed
dyadic level, its source point counts follow the fixed-level Poisson
delete-and-add process. -/

namespace Kr25Ssmxt

open Classical MeasureTheory

/-- The refreshed ghost fold at prescribed CV18 outcomes. -/
noncomputable def manuscriptOriginGivenVolumesLaw
    {n k : Nat} (hn : 21 ≤ n) (prep : TTCPreprocessor n k)
    (b : Nat) (eta delta threshold : Real) :
    (components : List
      (ManuscriptOriginCertifiedComponent n k hn prep b eta delta)) →
    (Fin components.length → VolumeOutcome) →
    ManuscriptOriginConfiguration n →
      Measure (ManuscriptOriginConfiguration n)
  | [], _, c => Measure.dirac c
  | d :: rest, outcomes, c =>
      (manuscriptOriginRefreshedComponentLaw hn d.polytope b eta threshold
        d.route (ttcPseudocode.t b n threshold (outcomes 0).2) c).bind
        (manuscriptOriginGivenVolumesLaw hn prep b eta delta threshold rest
          (fun i => outcomes i.succ))

theorem measurable_manuscriptOriginGivenVolumesLaw
    {n k : Nat} (hn : 21 ≤ n) (prep : TTCPreprocessor n k)
    (b : Nat) (eta delta threshold : Real) (hthreshold : 0 < threshold)
    (components : List
      (ManuscriptOriginCertifiedComponent n k hn prep b eta delta))
    (outcomes : Fin components.length → VolumeOutcome) :
    Measurable (manuscriptOriginGivenVolumesLaw hn prep b eta delta
      threshold components outcomes) := by
  induction components with
  | nil => exact Measure.measurable_dirac
  | cons d rest ih =>
      exact (Measure.measurable_bind' (ih (fun i => outcomes i.succ))).comp
        (measurable_manuscriptOriginRefreshedComponentLaw hn d.polytope b eta
          threshold hthreshold d.route
          (ttcPseudocode.t b n threshold (outcomes 0).2))

/-- The fixed-level steps generated by the ghost fold. -/
noncomputable def manuscriptOriginGivenVolumesSteps
    {n k : Nat} (hn : 21 ≤ n) (prep : TTCPreprocessor n k)
    (b : Nat) (eta delta threshold : Real)
    (S : Finset (LatticePoint n)) (level : Nat) :
    (components : List
      (ManuscriptOriginCertifiedComponent n k hn prep b eta delta)) →
    (Fin components.length → VolumeOutcome) → List (FixedLevelStep S)
  | [], _ => []
  | d :: rest, outcomes =>
      { deleted := componentDeletedCodes S d.polytope
        incoming := fun x => Real.toNNReal
          ((normalizedHitAndRunPointLaw hn d.polytope b d.route.1 eta
            d.route.2.1 d.route.2.2.1 d.route.2.2.2.1
              d.route.2.2.2.2).real {(x : LatticePoint n)} *
            ((unitInterval.toNNReal (survivalProbability level) *
              ttcPseudocode.t b n threshold (outcomes 0).2 : NNReal) :
                Real)) } ::
        manuscriptOriginGivenVolumesSteps hn prep b eta delta threshold S
          level rest (fun i => outcomes i.succ)

/-- Mixing a fixed second law and pushing through a binary map is the
corresponding product law. -/
theorem measure_bind_map_eq_prod_map
    {α β γ : Type*}
    [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    (ν : Measure α) (q : Measure β) [SFinite q]
    (f : α × β → γ) (hf : Measurable f) :
    ν.bind (fun a => q.map (fun x => f (a, x))) = (ν.prod q).map f := by
  rw [Measure.prod_eq_bind_map, map_bind_measure ν _ f
    Measurable.map_prodMk_left.aemeasurable hf]
  congr 1
  funext a
  rw [Measure.map_map hf measurable_prodMk_left]
  rfl

set_option maxHeartbeats 1000000 in
/-- For a refresh-stationary incoming law, the ghost fold's fixed-level
point counts are the fixed-level Poisson delete-and-add process. -/
theorem manuscriptOriginGivenVolumesLaw_fixedLevel
    {n k : Nat} (hn : 21 ≤ n) (prep : TTCPreprocessor n k)
    (b : Nat) (eta delta threshold : Real) (hthreshold : 0 < threshold)
    (S : Finset (LatticePoint n)) (level : Nat)
    (components : List
      (ManuscriptOriginCertifiedComponent n k hn prep b eta delta))
    (hsupport : ∀ d ∈ components,
      (normalizedHitAndRunPointLaw hn d.polytope b d.route.1 eta
        d.route.2.1 d.route.2.2.1 d.route.2.2.2.1 d.route.2.2.2.2)
        (S : Set (LatticePoint n))ᶜ = 0)
    (outcomes : Fin components.length → VolumeOutcome)
    (μ : Measure (ManuscriptOriginConfiguration n))
    (hstationary : μ.bind (fun c => c.refreshLaw) = μ) :
    (μ.bind (manuscriptOriginGivenVolumesLaw hn prep b eta delta threshold
        components outcomes)).map
        (fun c : ManuscriptOriginConfiguration n =>
          c.source.pointCounts level S) =
      fixedLevelLaw (manuscriptOriginGivenVolumesSteps hn prep b eta delta
        threshold S level components outcomes)
        (μ.map (fun c : ManuscriptOriginConfiguration n =>
          c.source.pointCounts level S)) := by
  induction components generalizing μ with
  | nil =>
      change (μ.bind Measure.dirac).map _ = μ.map _
      rw [Measure.bind_dirac]
  | cons d rest ih =>
      let intensity := ttcPseudocode.t b n threshold (outcomes 0).2
      let R := manuscriptOriginRefreshedComponentLaw hn d.polytope b eta
        threshold d.route intensity
      let G := manuscriptOriginGivenVolumesLaw hn prep b eta delta threshold
        rest (fun i => outcomes i.succ)
      have hR : Measurable R :=
        measurable_manuscriptOriginRefreshedComponentLaw hn d.polytope b eta
          threshold hthreshold d.route intensity
      have hG : Measurable G :=
        measurable_manuscriptOriginGivenVolumesLaw hn prep b eta delta
          threshold hthreshold rest (fun i => outcomes i.succ)
      have hbind : μ.bind (manuscriptOriginGivenVolumesLaw hn prep b eta delta
          threshold (d :: rest) outcomes) = (μ.bind R).bind G := by
        rw [Measure.bind_bind hR.aemeasurable hG.aemeasurable]
        rfl
      have hstat' : (μ.bind R).bind (fun c => c.refreshLaw) = μ.bind R :=
        manuscriptOriginRefreshedComponentLaw_bind_stationary hn d.polytope b
          eta threshold hthreshold d.route intensity μ
      have hsupp' : ∀ d' ∈ rest,
          (normalizedHitAndRunPointLaw hn d'.polytope b d'.route.1 eta
            d'.route.2.1 d'.route.2.2.1 d'.route.2.2.2.1 d'.route.2.2.2.2)
            (S : Set (LatticePoint n))ᶜ = 0 := by
        intro d' hd'
        exact hsupport d' (List.mem_cons_of_mem d hd')
      rw [hbind, ih hsupp' (fun i => outcomes i.succ) (μ.bind R) hstat']
      have hstep := manuscriptOrigin_stationary_fixedLevel_step hn d.polytope
        b eta threshold hthreshold d.route intensity μ hstationary S
        (hsupport d List.mem_cons_self) level
      change fixedLevelLaw _ ((μ.bind R).map _) = fixedLevelLaw _ _
      rw [hstep]
      change _ = fixedLevelLaw _
        (((μ.map _).prod (Measure.pi _)).map _)
      congr 1
      rw [← measure_bind_map_eq_prod_map _ _ _ (measurable_of_countable _)]
      apply Measure.bind_congr_right
      apply Filter.Eventually.of_forall
      intro old
      dsimp only
      congr 1
      funext incoming x
      simp [componentDeletedCodes, intensity]

end Kr25Ssmxt
